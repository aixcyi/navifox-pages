{
    "name": "@navifox/vitepress",
    "version": "0.0.0",
    "description": "基于目录结构与 frontmatter 自动生成 VitePress 导航与侧边栏的配置工具。",
    "keywords": [
        "auto-generate",
        "docs",
        "nav",
        "sidebar",
        "vitepress"
    ],
    "files": [
        "src"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "glob": "catalog:",
        "gray-matter": "catalog:",
        "markdown-it": "catalog:",
        "path-to-regexp": "catalog:"
    },
    "devDependencies": {
        "@types/markdown-it": "catalog:",
        "@types/node": "catalog:",
        "vite": "catalog:",
        "vitepress": "catalog:"
    },
    "peerDependencies": {
        "vite": "catalog:",
        "vitepress": "catalog:"
    }
}
