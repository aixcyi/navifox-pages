{
    "name": "navifox-pages",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "pnpm -r run build",
        "build:blog": "pnpm --filter @navifox/blog run build",
        "build:docs": "pnpm --filter @navifox/docs run build",
        "build:hei": "pnpm --filter @navifox/hei run build",
        "build:refs": "pnpm --filter @navifox/refs run build",
        "build:www": "pnpm --filter @navifox/www run build",
        "clean": "node ./scripts/clean.mjs",
        "dev:blog": "pnpm --filter @navifox/blog run dev --host",
        "dev:docs": "pnpm --filter @navifox/docs run dev --host",
        "dev:hei": "pnpm --filter @navifox/hei run dev --host",
        "dev:refs": "pnpm --filter @navifox/refs run dev --host",
        "dev:www": "pnpm --filter @navifox/www run dev --host",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "migrate": "pnpm dlx codemod pnpm/catalog && pnpm run format",
        "preview:blog": "pnpm --filter @navifox/blog run preview --host",
        "preview:docs": "pnpm --filter @navifox/docs run preview --host",
        "preview:hei": "pnpm --filter @navifox/hei run preview --host",
        "preview:refs": "pnpm --filter @navifox/refs run preview --host",
        "preview:www": "pnpm --filter @navifox/www run preview --host",
        "reinstall": "pnpm run clean --del-lock && pnpm install",
        "syncpack:fix": "syncpack fix && pnpm install",
        "syncpack:lint": "syncpack lint",
        "syncpack:list": "syncpack list",
        "typecheck": "pnpm -r run typecheck",
        "upgrade:check": "pnpm dlx taze --recursive",
        "upgrade:minor": "pnpm dlx taze minor -w --recursive",
        "upgrade:patch": "pnpm dlx taze patch -w --recursive"
    },
    "devDependencies": {
        "@navifox/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "syncpack": "catalog:",
        "typescript": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.11.0",
            "onFail": "warn"
        },
        "runtime": {
            "name": "node",
            "version": ">=22.22.2",
            "onFail": "error"
        }
    }
}
