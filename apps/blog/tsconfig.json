{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@navifox/tsconfig/web.json",
    "include": ["**/*.md", "**/*.ts", "**/*.vue", ".vitepress/**/*.ts", ".vitepress/**/*.vue"],
    "exclude": ["node_modules", "dist", "cache"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "#/*": [".vitepress/*"]
        }
    }
}
